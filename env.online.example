# =============================================================================
# Deploy online (VPS) — copie no servidor:
#   cp env.online.example .env.online
#   chmod 600 .env.online
#
# NUNCA commite .env.online (está no .gitignore).
# =============================================================================

ENVIRONMENT=online
APP_ENV=online

# URL canônica (sslip.io do IPv4 — troque hífens no host: 37.27.37.103 → 37-27-37-103)
PUBLIC_URL=https://37-27-37-103.sslip.io
PUBLIC_HOST=37-27-37-103.sslip.io
CORS_ORIGINS=https://37-27-37-103.sslip.io

# PostgreSQL (só rede Docker; não expõe porta no host)
DB_NAME=plumo
DB_USER=plumo
# Gere senha forte, ex. no VPS: openssl rand -base64 24
DB_PASSWORD=troque-por-senha-forte

# -----------------------------------------------------------------------------
# JWT — mesmo valor em auth + backend. Fase A: gere novo; fase B (restore): copie de .env.prod
# Gere: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=troque-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# -----------------------------------------------------------------------------
# ENCRYPTION_KEY — Fernet (AES), usada em campos criptografados no backend.
# Fase A: gere nova; fase B: OBRIGATORIAMENTE a mesma de .env.prod (senão dados cifrados quebram).
#
# No VPS (com Python do sistema ou após docker):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Windows (venv local do backend):
#   cd services\backend
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=troque-fernet-generate-key

# 1 = roda migrations no start do backend (fase A / banco vazio)
# 0 = após pg_restore completo (fase B) — não reaplica migrations
RUN_MIGRATIONS=1

LOG_LEVEL=INFO
SQL_ECHO=false
TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo