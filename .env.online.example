# Copie para .env.online no VPS: cp .env.online.example .env.online
# Não commitar .env.online (está no .gitignore)

ENVIRONMENT=online
APP_ENV=online

# URL canônica (sslip.io do IPv4 37.27.37.103)
PUBLIC_URL=https://37-27-37-103.sslip.io
PUBLIC_HOST=37-27-37-103.sslip.io
CORS_ORIGINS=https://37-27-37-103.sslip.io

# PostgreSQL (container interno)
DB_NAME=plumo
DB_USER=plumo
DB_PASSWORD=troque-por-senha-forte

# Segurança — após restore de prod, use os MESMOS valores de .env.prod
JWT_SECRET_KEY=troque-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
ENCRYPTION_KEY=troque-openssl-rand-hex-32

# 1 = migrations no start (fase A); 0 = após restore completo (fase B)
RUN_MIGRATIONS=1

LOG_LEVEL=INFO
SQL_ECHO=false
TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo